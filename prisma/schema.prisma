generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model departement {
  id               String            @id @default(uuid())
  name             String
  description      String
  user_id          String
  prokers          Proker[]
  user             user              @relation(fields: [user_id], references: [id])
  fotoDepartements fotoDepartement[]
}

model fotoDepartement {
  id             String      @id @default(uuid())
  departement_id String
  url            String
  namaFoto       String
  departement    departement @relation(fields: [departement_id], references: [id])
}

model user {
  id           String        @id @default(uuid())
  username     String
  password     String
  created_at   DateTime      @default(now())
  role         userrRole
  achievements Achievement[]
  activities   Activity[]
  departement  departement[]
}

model Achievement {
  id                 String            @id @default(uuid())
  title              String
  location           String
  created_by_user_id String
  description        String
  achiever_name      String
  achievement_date   DateTime
  created_at         DateTime          @default(now())
  user               user              @relation(fields: [created_by_user_id], references: [id])
  fotoAchievements   fotoAchievement[]
}

model Proker {
  id             String       @id @default(uuid())
  departement_id String
  name           String
  description    String
  status         prokerStatus @default(ComingSoon)
  event_start    DateTime
  event_end      DateTime
  location       String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now())
  departement    departement  @relation(fields: [departement_id], references: [id])
  fotoProkers    fotoProker[]
}

model fotoProker {
  id        String @id @default(uuid())
  proker_id String
  url       String
  proker    Proker @relation(fields: [proker_id], references: [id])
}

model fotoAchievement {
  id             String      @id @default(uuid())
  achievement_id String
  url            String
  achievement    Achievement @relation(fields: [achievement_id], references: [id])
}

model Activity {
  id                 String         @id @default(uuid())
  title              String
  description        String
  division           String
  location           String
  status             activityStatus @default(ComingSoon)
  event_start        DateTime
  event_end          DateTime
  created_by_user_id String
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now())
  user               user           @relation(fields: [created_by_user_id], references: [id])
  fotoActivities     fotoActivity[]
}

model fotoActivity {
  id          String   @id @default(uuid())
  activity_id String
  url         String
  activity    Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
}

enum prokerStatus {
  ComingSoon
  OnGoing
  Completed
}

enum userrRole {
  mba
  superUser
}

enum activityStatus {
  ComingSoon
  OnGoing
  Completed
}
